generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Alinhado a DC_EP084_24 + requisitos/RN_AUTH_Clerk_BancoProprio.md
// Senha, hash e sessão são responsabilidade do Clerk — não modelados aqui.
enum StatusUsuario {
  ATIVO
  INATIVO
}

enum TipoOperacao {
  LOGIN_SUCESSO
  LOGIN_FALHA
  LOGOFF
  BLOQUEIO_AUTOMATICO
  ACESSO_SIMULTANEO
  SYNC_PLANO_CONTAS
  AGRUPADOR_CRIADO
  AGRUPADOR_EDITADO
  AGRUPADOR_EXCLUIDO
  NATUREZA_ALTERADA
  VALOR_ORCADO_CONFIGURADO
  VERSAO_PROPOSTA_CRIADA
  SEMAFORO_CONFIGURADO
  RATEIO_IMPOSTO_CONFIGURADO
  RATEIO_IMPOSTO_DESATIVADO
  PROPOSTA_CRIADA
  VERSAO_PROPOSTA_EXCLUIDA
  PROPOSTA_DUPLICADA
  UNIDADE_FUNCIONAL_CRIADA
  UNIDADE_FUNCIONAL_INATIVADA
  CARGO_CRIADO
  CARGO_EDITADO
  META_CRIADA
  META_EDITADA
  META_EXCLUIDA
  EMPREGADO_CRIADO
  EMPREGADO_EDITADO
  EMPREGADO_EXCLUIDO
  EMPREGADOS_LOTE_CADASTRADO
  CARGO_BENEFICIOS_CONFIGURADOS
  CARGO_BENEFICIOS_EDITADOS
  BENEFICIO_ELEGIBILIDADE_CONFIGURADA
  BENEFICIO_ELEGIBILIDADE_EDITADA
  VIAGEM_CRIADA
  VIAGEM_EDITADA
  VIAGEM_EXCLUIDA
  ITEM_PATRIMONIAL_CADASTRADO
  ITEM_PATRIMONIAL_EDITADO
  ITEM_PATRIMONIAL_EXCLUIDO
  QTDE_EMPREGADO_CADASTRADA
  QTDE_EMPREGADO_EDITADA
  QTDE_EMPREGADO_EXCLUIDA
  TERMO_AJUSTE_SOLICITADO
  TERMO_AJUSTE_APROVADO_N1
  TERMO_AJUSTE_HOMOLOGADO
  TERMO_AJUSTE_REJEITADO
  EMPREGADOS_SNAPSHOT_RESSINCRONIZADO
  CARGO_EXCLUIDO
}

model Usuario {
  id                     String        @id @default(uuid())
  clerkUserId            String        @unique
  tenantId               String
  nomeCompleto           String
  email                  String        @unique
  status                 StatusUsuario @default(ATIVO)
  bloqueado              Boolean       @default(false)
  contadorFalhas         Int           @default(0)
  trocarSenhaObrigatoria Boolean       @default(false)
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt

  historicoOperacoes HistoricoOperacao[]
  perfis             UsuarioPerfil[]

  @@index([tenantId])
}

// Catálogo global de módulos do sistema — não pertence a nenhum tenant específico [ADR-001].
model Modulo {
  id    String  @id @default(uuid())
  chave String  @unique // ex: "dotacoes", "empenhos"
  nome  String
  ativo Boolean @default(true) // CA-01.03.03 — inativo é omitido do menu para todos os tenants

  funcionalidades Funcionalidade[]
}

// ADR-021 — NAVEGAVEL tem tela própria e aparece como link no menu da Tela Principal;
// CONTEXTUAL é uma permissão para uma ação dentro de outra tela (ex: configurar valor
// orçado de uma conta analítica) e nunca deve ganhar rota/link próprio no menu.
enum TipoFuncionalidade {
  NAVEGAVEL
  CONTEXTUAL
}

model Funcionalidade {
  id       String             @id @default(uuid())
  moduloId String
  modulo   Modulo             @relation(fields: [moduloId], references: [id])
  chave    String // ex: "empenhos.criar"
  nome     String
  tipo     TipoFuncionalidade @default(NAVEGAVEL)
  ativo    Boolean            @default(true)

  perfis PerfilFuncionalidade[]

  @@unique([moduloId, chave])
}

// Perfis são definidos por tenant [ADR-001] — RN0027/RN0030 pressupõem permissão por perfil, não por usuário.
model Perfil {
  id       String @id @default(uuid())
  tenantId String
  nome     String

  permissoes PerfilFuncionalidade[]
  usuarios   UsuarioPerfil[]

  @@unique([tenantId, nome])
  @@index([tenantId])
}

model PerfilFuncionalidade {
  perfilId         String
  perfil           Perfil         @relation(fields: [perfilId], references: [id])
  funcionalidadeId String
  funcionalidade   Funcionalidade @relation(fields: [funcionalidadeId], references: [id])

  @@id([perfilId, funcionalidadeId])
}

model UsuarioPerfil {
  usuarioId String
  usuario   Usuario @relation(fields: [usuarioId], references: [id])
  perfilId  String
  perfil    Perfil  @relation(fields: [perfilId], references: [id])
  tenantId  String // redundante de propósito — nunca confiar em join solto pra isolar tenant

  @@id([usuarioId, perfilId])
  @@index([tenantId])
}

// Append-only — nenhuma UPDATE/DELETE deve ser executada nesta tabela [RNF0006]
model HistoricoOperacao {
  id                   String       @id @default(uuid())
  tenantId             String
  usuarioId            String?
  usuario              Usuario?     @relation(fields: [usuarioId], references: [id])
  clerkSessionId       String?
  tipoOperacao         TipoOperacao
  descricao            String
  ipEstacao            String?
  quantidadeTentativas Int?
  dadosSerializados    Json?
  dataHoraEvento       DateTime     @default(now())

  @@index([tenantId])
  @@index([usuarioId])
}

// Parâmetros globais do sistema referenciados pelo módulo de autenticação [DC_EP084_24 §7]
model ParametroSistema {
  tenantId              String  @id
  limiteTentativasLogin Int     @default(5)
  flagManutencao        Boolean @default(false)
  diasUteisPadrao       Int     @default(22) // US-107a — usado na fórmula VA/VR
}

// UC03.00 — Plano de Contas Único.
// Cenário de teste atual: 4 níveis (formato N.N.NN.NNN), sem integração real com
// ERP Senior — payload vem de fixture fictícia via PlanoContasFixtureProvider.
enum StatusSincronismo {
  SINCRONIZADO
  PENDENTE
  ERRO
}

enum NaturezaConta {
  OPEX
  CAPEX
}

// Governada exclusivamente pela fonte externa (ERP Senior / fixture) — nenhum
// código de aplicação fora do PlanoContasBulkLoader escreve nesta tabela
// [RN_PLA_001, RN_PLA_002 — "Trava o Erro"].
model ContaContabil {
  id                 String            @id @default(uuid())
  tenantId           String
  codigoErp          String
  nomeConta          String
  nivel              Int // 1 a 4 no cenário de teste
  idPai              String?
  pai                ContaContabil?    @relation("Hierarquia", fields: [idPai], references: [id])
  filhas             ContaContabil[]   @relation("Hierarquia")
  isAnalitica        Boolean // true somente no último nível (nó folha) [RN_PLA_003]
  natureza           NaturezaConta? // parametrização local (RF_PLA_REQ_003), não vem da fonte externa
  // Semáforo Orçamentário (US-008, RN_PLA_006) — parametrização local, "todos ou nenhum".
  // Coerência (0<verde<amarelo<laranja<=100) garantida por CHECK constraint na migration [ADR-013].
  semaforoVerdePct   Int?
  semaforoAmareloPct Int?
  semaforoLaranjaPct Int?
  statusSync         StatusSincronismo @default(PENDENTE)
  syncedAt           DateTime?
  erpUpdatedAt       DateTime?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  agrupadorItens      ContaAgrupadoraItem[]
  valoresOrcados      ValorOrcadoConta[]
  viagensPassagem     Viagem[]              @relation("ViagemContaPassagem")
  viagensDiaria       Viagem[]              @relation("ViagemContaDiaria")
  viagensTransporte   Viagem[]              @relation("ViagemContaTransporte")
  itensPatrimoniais   ItemPatrimonial[]
  termosAjusteOrigem  TermoAjuste[]         @relation("TermoAjusteContaOrigem")
  termosAjusteDestino TermoAjuste[]         @relation("TermoAjusteContaDestino")
  cargos              Cargo[]
  empregados          EmpregadoHeadcount[]
  rateiosImposto      RateioImpostoGrade[]

  @@unique([tenantId, codigoErp])
  @@index([tenantId, nivel])
  @@index([tenantId, isAnalitica])
}

// SGO-exclusivo — CRUD completo permitido, isolado da árvore importada [RN_PLA_007].
model ContaAgrupadora {
  id        String   @id @default(uuid())
  tenantId  String
  nome      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  itens ContaAgrupadoraItem[]

  @@unique([tenantId, nome]) // RN_PLA_008(a)
  @@index([tenantId])
}

model ContaAgrupadoraItem {
  agrupadoraId String
  agrupadora   ContaAgrupadora @relation(fields: [agrupadoraId], references: [id], onDelete: Cascade)
  contaId      String
  conta        ContaContabil   @relation(fields: [contaId], references: [id])

  @@id([agrupadoraId, contaId])
  @@index([contaId])
}

// Lock pessimista de sincronismo por tenant [RNF_PLA_REQ_007].
model SincronismoPlanoContasLock {
  tenantId    String    @id
  emAndamento Boolean   @default(false)
  iniciadoEm  DateTime?
  iniciadoPor String?
}

// ADR-012 — modelagem mínima de Proposta/Versão, suficiente para destravar US-007.
// O escopo completo de UC03.04 (Manter Proposta: listagem, filtros, Aditivo) não é
// implementado aqui — apenas o necessário para Proposta e VersaoProposta existirem
// como entidades reais e servirem de FK para ValorOrcadoConta.
enum TipoProposta {
  CONTRATO
  TERMO_DE_PARCERIA
}

enum CategoriaProposta {
  CONSOLIDADA
  POR_META
}

enum StatusProposta {
  RASCUNHO
  EM_ELABORACAO
  OFICIALIZADO
  ENCERRADO
}

model Proposta {
  id         String            @id @default(uuid())
  tenantId   String
  codigo     String
  nome       String
  tipo       TipoProposta
  categoria  CategoriaProposta
  dataInicio DateTime
  dataFim    DateTime
  status     StatusProposta    @default(RASCUNHO)
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  versoes            VersaoProposta[]
  unidadesFuncionais UnidadeFuncional[]
  cargos             Cargo[]
  empregados         EmpregadoHeadcount[]
  qtdeEmpregados     QtdeEmpregado[]

  @@unique([tenantId, codigo])
  @@index([tenantId, status])
}

// vigente=true identifica a versão corrente da Proposta (sempre a de maior
// numeroVersao entre as não excluídas). Unicidade de "um vigente por proposta"
// é garantida por índice único parcial em SQL puro na migration — Prisma não
// suporta unique parcial nativamente [ADR-012].
model VersaoProposta {
  id           String         @id @default(uuid())
  tenantId     String
  propostaId   String
  proposta     Proposta       @relation(fields: [propostaId], references: [id])
  numeroVersao Int
  descricao    String?
  status       StatusProposta @default(RASCUNHO)
  vigente      Boolean        @default(false)
  ativa        Boolean        @default(true) // soft delete — nunca DELETE físico [UC03.11]
  createdAt    DateTime       @default(now())
  createdBy    String

  valoresOrcados    ValorOrcadoConta[]
  rateiosImposto    RateioImpostoGrade[]
  meta              Meta?
  viagens           Viagem[]
  itensPatrimoniais ItemPatrimonial[]
  termosAjuste      TermoAjuste[]

  @@unique([tenantId, propostaId, numeroVersao])
  @@index([tenantId, propostaId, vigente])
}

// US-111 (UC03.13, ADR-025) — redistribui saldo entre 2 ContaContabil isAnalitica=true
// da mesma VersaoProposta, sem alterar o valor global (SUM(ValorOrcadoConta) da versão
// é o mesmo antes/depois). Aprovação em 2 etapas via PerfilFuncionalidade — "Gestor
// Master" é uma linha de Perfil (dado de seed), não um campo de hierarquia em Perfil
// [decisão ADR-025, rejeitada complexidade especulativa de nivelHierarquico genérico].
enum StatusTermoAjuste {
  PENDENTE_APROVACAO_N1
  PENDENTE_APROVACAO_GESTOR_MASTER
  HOMOLOGADO
  REJEITADO
}

model TermoAjuste {
  id             String            @id @default(uuid())
  tenantId       String
  versaoId       String
  versao         VersaoProposta    @relation(fields: [versaoId], references: [id])
  contaOrigemId  String
  contaOrigem    ContaContabil     @relation("TermoAjusteContaOrigem", fields: [contaOrigemId], references: [id])
  contaDestinoId String
  contaDestino   ContaContabil     @relation("TermoAjusteContaDestino", fields: [contaDestinoId], references: [id])
  exercicio      Int
  valor          Decimal           @db.Decimal(15, 2)
  status         StatusTermoAjuste @default(PENDENTE_APROVACAO_N1)
  createdBy      String
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([tenantId, versaoId])
  @@index([tenantId, status])
}

// ADR-017 — US-112. Meta é 1:1 OPCIONAL por VersaoProposta: existe no máximo 1
// Meta quando Proposta.categoria=POR_META; nenhuma quando categoria=CONSOLIDADA.
// valorGlobal nunca é digitado — é sempre um espelho de SUM(ValorOrcadoConta.valor)
// para a mesma versão (todos os exercícios, já que o contrato pode cobrir de 12
// a 120 meses) [ORIGEM BLINDADA], recalculado a cada escrita.
enum StatusMeta {
  ATIVO
  INATIVO
}

model Meta {
  id       String         @id @default(uuid())
  tenantId String
  versaoId String         @unique
  versao   VersaoProposta @relation(fields: [versaoId], references: [id])

  tipo        String
  nome        String
  valorGlobal Decimal    @db.Decimal(15, 2)
  status      StatusMeta @default(ATIVO)
  observacao  String?

  ativo     Boolean  @default(true) // soft delete
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  viagens           Viagem[]
  itensPatrimoniais ItemPatrimonial[]
  empregados        EmpregadoHeadcount[]
  qtdeEmpregados    QtdeEmpregado[]

  @@index([tenantId, versaoId])
}

// ADR-022 — US-109. Viagem só existe quando Proposta.categoria=POR_META (exige
// metaId — mesma Meta 1:1 da versão, [[Meta]] ADR-017), nunca em CONSOLIDADA.
// As 3 contas (passagem/diária/transporte) devem ser isAnalitica=true — validado
// só na camada de aplicação, igual ValorOrcadoConta (não há CHECK/FK parcial
// possível no Prisma para "isAnalitica=true" da conta referenciada).
// custoEstimado é persistido e recalculado a cada create/update (mesmo padrão de
// Cargo.salarioTotal), nunca input direto do usuário [ORIGEM BLINDADA].
// Fora de escopo: validação de teto agregado por Conta Sintética Mãe somando
// várias Viagens — não existe TotalizerService formal ainda (mesmo gap de
// RN0274/US-108a). Sem lock pessimista — mesma simplicidade transacional de
// Cargo/Meta, sem race condition crítica identificada.
model Viagem {
  id       String         @id @default(uuid())
  tenantId String
  versaoId String
  versao   VersaoProposta @relation(fields: [versaoId], references: [id])
  // Nullable — obrigatório só quando Proposta.categoria=POR_META (mesmo padrão de
  // ItemPatrimonial.metaId, ADR-023); sempre null em CONSOLIDADA.
  metaId   String?
  meta     Meta?          @relation(fields: [metaId], references: [id])

  descricao String // até 100 caracteres, validado na aplicação

  quantidadePessoas Int
  mediaDias         Int

  custoUnitarioPassagem Decimal       @db.Decimal(15, 2)
  contaPassagemId       String
  contaPassagem         ContaContabil @relation("ViagemContaPassagem", fields: [contaPassagemId], references: [id])

  custoUnitarioDiaria Decimal       @db.Decimal(15, 2)
  contaDiariaId       String
  contaDiaria         ContaContabil @relation("ViagemContaDiaria", fields: [contaDiariaId], references: [id])

  custoUnitarioTransporte Decimal       @db.Decimal(15, 2)
  contaTransporteId       String
  contaTransporte         ContaContabil @relation("ViagemContaTransporte", fields: [contaTransporteId], references: [id])

  // Calculado e persistido pelo use case a cada create/update — nunca input direto.
  custoEstimado Decimal @db.Decimal(15, 2)

  ativo     Boolean  @default(true) // soft delete
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, versaoId])
  @@index([tenantId, metaId])
}

// ADR-023 — US-110. ItemPatrimonial cobre Bens, Serviços e Equipamentos (CAPEX),
// UC03.34-37 da Minuta V5. Estrutura análoga a Viagem (ADR-022), mas metaId é
// nullable — obrigatório só quando Proposta.categoria=POR_META (mesma Meta 1:1
// da versão, [[Meta]] ADR-017); sempre null em Proposta CONSOLIDADA. Validado
// só na camada de aplicação (Prisma não suporta FK condicional).
// contaId aceita qualquer ContaContabil.isAnalitica=true, sem filtro de grupo
// Imobilizado/Intangível (tag de natureza CAPEX não existe no schema ainda —
// fica para quando/se for refinada como US própria).
// valorTotal é persistido e recalculado a cada create/update, nunca input
// direto do usuário [ORIGEM BLINDADA], mesmo padrão de Viagem.custoEstimado.
// Sem lock pessimista — mesma simplicidade transacional de Cargo/Viagem/Meta.
model ItemPatrimonial {
  id       String         @id @default(uuid())
  tenantId String
  versaoId String
  versao   VersaoProposta @relation(fields: [versaoId], references: [id])
  metaId   String?
  meta     Meta?          @relation(fields: [metaId], references: [id])
  contaId  String
  conta    ContaContabil  @relation(fields: [contaId], references: [id])

  descricao String // até 100 caracteres, validado na aplicação
  data      DateTime

  quantidade    Int
  valorUnitario Decimal @db.Decimal(15, 2)

  // Calculado e persistido pelo use case a cada create/update — nunca input direto.
  valorTotal Decimal @db.Decimal(15, 2)

  ativo     Boolean  @default(true) // soft delete
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, versaoId])
  @@index([tenantId, metaId])
  @@index([tenantId, contaId])
}

// US-007 — valor orçado de uma conta analítica (isAnalitica=true), escopado por
// Proposta/Versão e exercício. Contas sintéticas nunca têm linha aqui: seu total
// é calculado sob demanda por soma recursiva das folhas descendentes na mesma
// versão+exercício (ValorOrcadoTotalizerService), decisão registrada em ADR-011/012.
model ValorOrcadoConta {
  id        String         @id @default(uuid())
  tenantId  String
  versaoId  String
  versao    VersaoProposta @relation(fields: [versaoId], references: [id])
  contaId   String
  conta     ContaContabil  @relation(fields: [contaId], references: [id])
  exercicio Int
  valor     Decimal        @db.Decimal(15, 2)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@unique([tenantId, versaoId, contaId, exercicio])
  @@index([tenantId, versaoId])
}

// ADR-014 — US-101. Parâmetro fiscal GLOBAL por tenant (não por Proposta), com
// vigência temporal. `nomeNormalizado` (lowercase) existe só para viabilizar a
// unicidade case-insensitive (RN_TAX_05) dentro do Prisma, sem depender de
// citext (indisponível/arriscado no plano gratuito do Supabase).
enum TipoIncidenciaImposto {
  CONTRATO
  TERMO_DE_PARCERIA
  AMBOS
}

model AliquotaImpostoParametro {
  id                 String                @id @default(uuid())
  tenantId           String
  nome               String
  nomeNormalizado    String
  aliquotaPct        Decimal               @db.Decimal(5, 2)
  dataInicioVigencia DateTime
  tipoIncidencia     TipoIncidenciaImposto
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  rateios RateioImpostoGrade[]

  @@unique([tenantId, nomeNormalizado])
  @@index([tenantId, tipoIncidencia])
}

// US-101 — grão: (versão da Proposta × tributo × competência/mês). `ativo`
// implementa soft delete (ADR-014 item 4): desmarcar um tributo não apaga o
// histórico de valores já declarados, só o exclui do cálculo do Valor Global.
model RateioImpostoGrade {
  id                       String                   @id @default(uuid())
  tenantId                 String
  versaoId                 String
  versao                   VersaoProposta           @relation(fields: [versaoId], references: [id])
  aliquotaParametroId      String
  aliquotaParametro        AliquotaImpostoParametro @relation(fields: [aliquotaParametroId], references: [id])
  // ADR-027 — 1 conta analítica por linha de rateio (mesma granularidade
  // de aliquotaParametroId x competencia).
  contaId                  String
  conta                    ContaContabil            @relation(fields: [contaId], references: [id])
  competencia              DateTime
  valorDeclarado           Decimal                  @db.Decimal(15, 2)
  aliquotaAplicadaSnapshot Decimal                  @db.Decimal(5, 2)
  ativo                    Boolean                  @default(true)
  createdAt                DateTime                 @default(now())
  updatedAt                DateTime                 @updatedAt

  @@unique([tenantId, versaoId, aliquotaParametroId, competencia])
  @@index([tenantId, versaoId])
}

// ADR-015 — US-106. Escopada por Proposta, não por VersaoProposta: organograma
// é dado cadastral estável (reestruturação de RH é evento raro e deliberado),
// diferente de ValorOrcadoConta/RateioImpostoGrade, que mudam a cada revisão
// orçamentária por design. Árvore de 2 níveis fixos: Sintético (Diretoria ou
// Gerência, só consolida) → Analítico (Assessor só sob Diretoria; Coordenadoria
// ou Setor só sob Gerência).
enum TipoNivelUnidadeFuncional {
  SINTETICO_DIRETORIA
  SINTETICO_GERENCIA
  ANALITICO_ASSESSOR
  ANALITICO_COORDENADORIA
  ANALITICO_SETOR
}

model UnidadeFuncional {
  id         String                    @id @default(uuid())
  tenantId   String
  propostaId String
  proposta   Proposta                  @relation(fields: [propostaId], references: [id])
  nome       String
  tipoNivel  TipoNivelUnidadeFuncional
  idPai      String?
  pai        UnidadeFuncional?         @relation("HierarquiaFuncional", fields: [idPai], references: [id])
  filhas     UnidadeFuncional[]        @relation("HierarquiaFuncional")
  ativa      Boolean                   @default(true)
  createdAt  DateTime                  @default(now())
  updatedAt  DateTime                  @updatedAt

  alocacoesCargo CargoAlocacaoPercentual[]

  @@index([tenantId, propostaId])
  @@index([tenantId, propostaId, idPai])
}

// ADR-016 — US-107. Cargo vinculado 1:1 a um nó Analítico da Estrutura Funcional
// (UnidadeFuncional). A validação de que a unidade vinculada é de fato Analítica
// (ANALITICO_ASSESSOR/COORDENADORIA/SETOR, nunca SINTETICO_*) é feita no use case
// (validarVinculoNoAnalitico), não em constraint de banco — mesmo padrão de
// RN_PLA_003 (isAnalitica em ContaContabil).
enum FonteAtivaSalario {
  MERCADO_MINIMO
  MERCADO_MAXIMO
  RUBI
}

model Cargo {
  id         String   @id @default(uuid())
  tenantId   String
  propostaId String
  proposta   Proposta @relation(fields: [propostaId], references: [id])

  alocacoes CargoAlocacaoPercentual[]

  // ADR-027 — natureza da despesa (ex: "Despesa com Pessoal"), 1 conta
  // analítica fixa por Cargo. Independente de `alocacoes` (organograma):
  // são dimensões distintas, plano de contas x estrutura funcional.
  contaId String
  conta   ContaContabil @relation(fields: [contaId], references: [id])

  nomeCargoMercado  String
  codigoCargo       String // gerado internamente (CARGO-{ano}-{seq}), Read-only na UI
  funcaoGratificada Decimal? @db.Decimal(15, 2)
  periodoInicio     DateTime

  salarioMercadoMinimo Decimal           @db.Decimal(15, 2)
  salarioMercadoMaximo Decimal           @db.Decimal(15, 2)
  fonteAtiva           FonteAtivaSalario

  // Bloco "soberano" [RN_CAR_03] — nunca escrito por use case de Cargo, só pelo
  // CargoRubiFixtureProvider (fixture; não há integração real com Rubi ainda).
  salarioReal       Decimal?          @db.Decimal(15, 2)
  statusSyncSalario StatusSincronismo @default(PENDENTE)
  syncedAt          DateTime?
  erpUpdatedAt      DateTime?

  // Calculado e persistido pelo use case a cada create/update — nunca input direto.
  salarioTotal Decimal @db.Decimal(15, 2)

  // ADR-019 — US-107a: Encargos e Benefícios. Atributos do próprio Cargo (sem
  // CRUD/cardinalidade próprios que justifiquem tabela separada) — sempre
  // editados junto do Cargo, na mesma tela.
  encargosSociaisPct Decimal @default(0) @db.Decimal(5, 2) // 0-100, validado no use case

  vaAtivo         Boolean @default(false)
  vaValorUnitario Decimal @default(0) @db.Decimal(15, 2)

  vrAtivo         Boolean @default(false)
  vrValorUnitario Decimal @default(0) @db.Decimal(15, 2)

  planoSaudeAtivo Boolean          @default(false)
  planoSaudeFaixa FaixaPlanoSaude?
  planoSaudeValor Decimal          @default(0) @db.Decimal(15, 2)

  planoOdontoAtivo Boolean @default(false)
  planoOdontoValor Decimal @default(0) @db.Decimal(15, 2)

  seguroVidaAtivo Boolean @default(false)
  seguroVidaValor Decimal @default(0) @db.Decimal(15, 2)

  auxilioCrecheAtivo Boolean @default(false)
  auxilioCrecheValor Decimal @default(0) @db.Decimal(15, 2)

  // ADR-020 — US-108a: Vale Transporte, lacuna documental corrigida (a
  // Minuta citava Transporte no UC03.28 mas ele nunca foi modelado em
  // ADR-019). Mesma fórmula de VA/VR.
  transporteAtivo         Boolean @default(false)
  transporteValorUnitario Decimal @default(0) @db.Decimal(15, 2)

  // ADR-029 — conta analítica por componente de custo (não é @relation formal:
  // 9 FKs opcionais para ContaContabil validadas na camada de aplicação, mesmo
  // padrão de "sem lock explícito" já usado em outros pontos — evita 9 relações
  // nomeadas + 9 campos de retorno em ContaContabil, desproporcional ao ganho).
  // Cada uma pode ficar null se o benefício correspondente nunca foi configurado.
  contaGratificacaoId     String?
  contaEncargosSociaisId  String?
  contaValeAlimentacaoId  String?
  contaValeRefeicaoId     String?
  contaValeTransporteId   String?
  contaPlanoOdontologicoId String?
  contaSeguroVidaId       String?
  contaPlanoSaudeId       String?
  contaAuxilioCrecheId    String?

  // Calculado e persistido pelo use case a cada create/update — nunca input direto.
  custoTotalCargo Decimal @default(0) @db.Decimal(15, 2)

  ativo     Boolean  @default(true) // soft delete
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  empregados EmpregadoHeadcount[]

  @@unique([tenantId, codigoCargo])
  @@index([tenantId, propostaId])
}

// ADR-026 — RN_EST_03 (UC03.18). Substitui o vínculo 1:1 de ADR-016
// (Cargo.unidadeFuncionalId) por rateio percentual N:M: um Cargo pode ser
// distribuído por múltiplas UnidadeFuncional analíticas, soma sempre 100%.
// Soma e "só nível Analítico" (RN_EST_02) são validadas no use case a cada
// substituição atômica do array de alocações — mesmo padrão de
// validarVinculoNoAnalitico (ADR-016) e RN_PLA_003 (isAnalitica).
model CargoAlocacaoPercentual {
  id                 String           @id @default(uuid())
  tenantId           String
  cargoId            String
  cargo              Cargo            @relation(fields: [cargoId], references: [id])
  unidadeFuncionalId String
  unidadeFuncional   UnidadeFuncional @relation(fields: [unidadeFuncionalId], references: [id])
  percentual         Decimal          @db.Decimal(5, 2)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@unique([tenantId, cargoId, unidadeFuncionalId])
  @@index([tenantId, cargoId])
  @@index([tenantId, unidadeFuncionalId])
}

// ADR-019 — US-107a.
enum FaixaPlanoSaude {
  BASICO
  INTERMEDIARIO
  EXECUTIVO
}

// ADR-018 — US-108. EmpregadoHeadcount é escopado por Proposta (nesta US, só
// categoria=CONSOLIDADA) e herda um SNAPSHOT (não FK viva) de Vínculo Funcional
// e Custo Total Mensal do Cargo no momento do cadastro/troca de cargo — mesmo
// princípio de Cargo.salarioTotal (ADR-016): congelado até ação explícita do
// usuário, nunca retroage sozinho se o Cargo for editado depois [ORIGEM BLINDADA].
enum CategoriaEmpregado {
  EMPREGADO
  ESTAGIARIO
  JOVEM_APRENDIZ
}

model EmpregadoHeadcount {
  id         String   @id @default(uuid())
  tenantId   String
  propostaId String
  proposta   Proposta @relation(fields: [propostaId], references: [id])

  // ADR-024 — US-113. Nullable — obrigatório apenas quando Proposta.categoria=
  // POR_META (derivado automaticamente da Meta 1:1 da versão vigente, [[Meta]]
  // ADR-017), sempre null em CONSOLIDADA. Validado só na camada de aplicação
  // (Prisma não suporta FK condicional). Adicionado retroativamente sem
  // backfill — tabela vazia em produção no momento desta migration.
  metaId String?
  meta   Meta?   @relation(fields: [metaId], references: [id])

  cargoId String
  cargo   Cargo  @relation(fields: [cargoId], references: [id])

  nome          String // "A CONTRATAR" se vaga de contingência (RN0249)
  categoria     CategoriaEmpregado
  periodoInicio DateTime
  periodoFim    DateTime?

  // DEPRECATED (ADR-020, US-108a) — dependentes agora são por benefício, em
  // EmpregadoBeneficioElegibilidade.numeroDependentes. Mantido só para não
  // quebrar dados já persistidos (US-108); os use cases de Empregado deixam
  // de aceitá-lo como input a partir de US-108a. Não remover fisicamente sem
  // decisão de negócio explícita sobre migração dos valores existentes.
  numeroDependentes Int @default(0)

  // Snapshot herdado do Cargo — recalculado só na criação e na troca de cargoId.
  vinculoFuncionalHerdado String
  custoTotalMensal        Decimal @db.Decimal(15, 2)

  // ADR-027 — snapshot de Cargo.contaId, mesma regra de congelamento de
  // vinculoFuncionalHerdado/custoTotalMensal: só recalculado na criação e na
  // troca de cargoId, nunca editável diretamente.
  contaId String
  conta   ContaContabil @relation(fields: [contaId], references: [id])

  // ADR-029 — snapshot de valor + conta de cada componente de custo do Cargo,
  // mesmo congelamento de contaId/custoTotalMensal acima (nunca recalculado
  // retroativamente). valorSalarioSnapshot é residual: custoTotalMensal menos
  // a soma dos demais 8 — garante que a soma de todas as contas bate exatamente
  // com custoTotalMensal, sem sobra nem furo, não importa quais componentes
  // estavam ativos no Cargo no momento do snapshot. Conta null = componente
  // sem conta configurada no Cargo; nesse caso o valor cai dentro do valor de
  // salário (mesma conta contaId acima), nunca é perdido nem contado 2x.
  valorSalarioSnapshot         Decimal @default(0) @db.Decimal(15, 2)
  valorGratificacaoSnapshot    Decimal @default(0) @db.Decimal(15, 2)
  contaGratificacaoId          String?
  valorEncargosSociaisSnapshot Decimal @default(0) @db.Decimal(15, 2)
  contaEncargosSociaisId       String?
  valorValeAlimentacaoSnapshot Decimal @default(0) @db.Decimal(15, 2)
  contaValeAlimentacaoId       String?
  valorValeRefeicaoSnapshot    Decimal @default(0) @db.Decimal(15, 2)
  contaValeRefeicaoId          String?
  valorValeTransporteSnapshot  Decimal @default(0) @db.Decimal(15, 2)
  contaValeTransporteId        String?
  valorPlanoOdontologicoSnapshot Decimal @default(0) @db.Decimal(15, 2)
  contaPlanoOdontologicoId     String?
  valorSeguroVidaSnapshot      Decimal @default(0) @db.Decimal(15, 2)
  contaSeguroVidaId            String?
  valorPlanoSaudeSnapshot      Decimal @default(0) @db.Decimal(15, 2)
  contaPlanoSaudeId            String?
  valorAuxilioCrecheSnapshot   Decimal @default(0) @db.Decimal(15, 2)
  contaAuxilioCrecheId         String?

  ativo     Boolean  @default(true) // soft delete
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  beneficiosElegibilidade EmpregadoBeneficioElegibilidade[]

  @@index([tenantId, propostaId])
  @@index([tenantId, cargoId])
  @@index([tenantId, metaId])
}

// ADR-024 — US-113 (UC03.20-23). Snapshot/consolidação de headcount por
// período e documento de respaldo (Apostilamento/Termo Aditivo). Quantitativos
// são ORIGEM BLINDADA: calculados por COUNT sobre EmpregadoHeadcount ativo no
// momento do create/update, nunca input direto — mesmo padrão de
// Cargo.custoTotalCargo e Viagem.custoEstimado. metaId segue a mesma regra
// condicional de EmpregadoHeadcount. Sem lock pessimista — mesma simplicidade
// de Cargo/Viagem/Meta/ItemPatrimonial. Sem checagem de despesas vinculadas na
// exclusão (RN0145/E2 da Minuta) — não existe módulo de Diária/Adiantamento;
// mesmo gap aceito em Excluir Viagem/Meta UseCase.
model QtdeEmpregado {
  id         String   @id @default(uuid())
  tenantId   String
  propostaId String
  proposta   Proposta @relation(fields: [propostaId], references: [id])
  metaId     String?
  meta       Meta?    @relation(fields: [metaId], references: [id])

  periodoInicio   DateTime
  periodoFim      DateTime
  numeroDocumento String

  // Calculados e persistidos pelo use case a cada create/update — nunca input direto.
  quantidadeEmpregados    Int
  quantidadeEstagiarios   Int
  quantidadeJovemAprendiz Int

  // US-113b — snapshot do custo total do período consolidado (overlap entre
  // o período de cada EmpregadoHeadcount e o período deste documento).
  // Nunca recalculado retroativamente: é o valor "fotografado" no momento da
  // consolidação, mesmo que o custoTotalCargo do Cargo mude depois.
  valorTotalConsolidado Decimal @default(0) @db.Decimal(15, 2)

  ativo     Boolean  @default(true) // soft delete
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, propostaId, numeroDocumento])
  @@index([tenantId, propostaId])
  @@index([tenantId, metaId])
}

// ADR-020 — US-108a. Elegibilidade individual do Empregado por benefício —
// distinta da Tabela Mestre do Cargo (ADR-019, "o benefício existe e tem
// valor") e do snapshot congelado de custo (ADR-018, "quanto esse Empregado
// custava quando foi vinculado"). O valor financeiro é sempre lido AO VIVO
// do Cargo na leitura (não persistido aqui) — elegibilidade é registro de
// uso, não histórico de custo.
enum TipoBeneficioElegibilidade {
  VA
  VR
  PLANO_SAUDE
  PLANO_ODONTO
  SEGURO_VIDA
  AUXILIO_CRECHE
  VALE_TRANSPORTE
}

model EmpregadoBeneficioElegibilidade {
  id       String @id @default(uuid())
  tenantId String

  empregadoId String
  empregado   EmpregadoHeadcount @relation(fields: [empregadoId], references: [id])

  tipoBeneficio TipoBeneficioElegibilidade

  ativo             Boolean   @default(false)
  periodoInicio     DateTime?
  periodoFim        DateTime?
  numeroDependentes Int       @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, empregadoId, tipoBeneficio])
  @@index([tenantId, empregadoId])
}
