{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "shell": "powershell",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"$CLAUDE_PROJECT_DIR/.claude/hooks/session-status.ps1\"",
            "timeout": 15,
            "statusMessage": "Carregando STATUS_PROJETO.md"
          }
        ]
      }
    ]
  }
}
